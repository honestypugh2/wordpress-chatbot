# =============================================================================
# County Assistant — environment configuration (template)
# =============================================================================
# Copy to .env and fill in real values:  cp .env.example .env
#
# This file lists EVERY setting read by src/app/config/settings.py. All values
# below are safe placeholders/defaults. With no .env at all, the app runs in the
# fully-offline "local" fallback (RETRIEVAL_PATTERN=local) so it is always
# runnable. Never commit a real .env (it is .gitignored). In shared/cloud
# environments prefer managed identity + Key Vault over plaintext secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV="local"                 # local | dev | prod
APP_NAME="county-assistant"
APP_LOG_LEVEL="INFO"            # DEBUG | INFO | WARNING | ERROR
APP_LOG_JSON="false"            # true => structured JSON logs (prod/log pipelines)
APP_HOST="0.0.0.0"
APP_PORT="8000"
# Comma-separated list of allowed CORS origins (your WordPress site origin(s)).
APP_CORS_ORIGINS="https://county-portal.example.gov,http://localhost:8083"

# -----------------------------------------------------------------------------
# Azure AI Foundry (azure-ai-projects ~= 2.2.0)
# -----------------------------------------------------------------------------
# Foundry PROJECT endpoint. Required for any cloud (non-local) pattern.
AZURE_AI_PROJECT_ENDPOINT="https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project>"
# Optional ACCOUNT endpoint for the OpenAI-compatible client (chat + embeddings).
# Leave blank to derive it from AZURE_AI_PROJECT_ENDPOINT.
AZURE_AI_ACCOUNT_ENDPOINT=""
# Chat model deployment name in your Foundry project.
AZURE_AI_MODEL_DEPLOYMENT="gpt-4o-mini"
# Optional: reuse an existing persisted agent ID instead of creating one.
AZURE_AI_AGENT_ID=""
AZURE_OPENAI_API_VERSION="2024-10-21"
# Master switch: when false (or endpoint blank) the orchestrator uses the local
# grounded fallback so the prototype runs without cloud access.
FOUNDRY_ENABLED="false"

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# The prototype uses DefaultAzureCredential (az login / managed identity).
# These are only needed if you explicitly use a service principal locally.
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
# Do NOT commit real secrets. Prefer Key Vault / managed identity in shared envs.
AZURE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Retrieval pattern selection  (the switch you flip per demo)
# -----------------------------------------------------------------------------
# local        — in-memory index over data/county_kb (offline demos)
# azure_search — Azure AI Search RAG over ingested WordPress content
# bing         — Grounding with Bing Custom Search via a Foundry prompt agent
# hybrid       — Azure AI Search first; Bing Custom Search fallback on weak/no hits
RETRIEVAL_PATTERN="local"
# Which WordPress demo front-end the assistant is presented on.
DEMO_SITE_PROFILE="westvale"    # westvale (synthetic) | staging (customer staging)

# -----------------------------------------------------------------------------
# Grounding with Bing Custom Search (Foundry "prompt agent" tool)
# -----------------------------------------------------------------------------
BING_GROUNDING_ENABLED="false"
# Name of an existing Foundry prompt agent that has the Bing grounding tool.
BING_GROUNDING_AGENT_NAME=""
# Foundry connection NAME for the Bing Custom Search resource (resolved to id).
BING_CONNECTION_NAME=""
# Or the Foundry connection ID directly (used as-is if set).
BING_CONNECTION_ID=""
# Bing Custom Search configuration/instance name scoping the allowed domains.
BING_CUSTOM_SEARCH_INSTANCE_NAME=""
# Optional override: comma-separated public domains the Bing instance is scoped to.
BING_ALLOWED_DOMAINS=""
# Hybrid fallback thresholds: route to Bing when AI Search returns fewer than
# N hits or the top semantic-reranker score (0-4 scale) is below the floor.
HYBRID_MIN_RESULTS="1"
HYBRID_MIN_SCORE="2.0"

# -----------------------------------------------------------------------------
# Retrieval / RAG (Azure AI Search)
# -----------------------------------------------------------------------------
# When AZURE_SEARCH_ENDPOINT is set, the app uses Azure AI Search; otherwise it
# falls back to the local in-memory index over data/county_kb.
AZURE_SEARCH_ENDPOINT="https://<your-search>.search.windows.net"
AZURE_SEARCH_INDEX="county-kb"
# Leave the key blank to authenticate with managed identity / az login (recommended).
AZURE_SEARCH_API_KEY=""
# Semantic-ranker configuration name on the index (matches scripts/index_kb_to_search.py).
AZURE_SEARCH_SEMANTIC_CONFIG="county-semantic"
# false => ground via the Foundry AI Search tool (Pattern 2 default).
# true  => use the in-repo custom retriever (LocalRetriever / AzureAISearchRetriever).
AZURE_SEARCH_USE_CUSTOM_RETRIEVER="false"
# Foundry connection NAME for Azure AI Search (resolved to id).
AZURE_SEARCH_CONNECTION_NAME=""
# Or the Foundry connection ID directly.
AZURE_SEARCH_CONNECTION_ID=""
# Name of an existing Foundry prompt agent with the AI Search tool.
AZURE_SEARCH_AGENT_NAME=""
# AI Search tool query type: simple | vector | semantic | *_hybrid.
AZURE_SEARCH_QUERY_TYPE="vector_semantic_hybrid"

# Embeddings (vector / hybrid retrieval) — generated via the Foundry project.
AZURE_EMBEDDING_DEPLOYMENT="text-embedding-3-small"
AZURE_EMBEDDING_DIMENSIONS="1536"
# Set true once the index has vectors to run hybrid keyword+vector queries.
RAG_VECTOR_ENABLED="false"

# Local knowledge base + chunking (used by the local retriever).
RAG_KB_PATH="data/county_kb"
RAG_TOP_K="4"
RAG_CHUNK_SIZE="900"
RAG_CHUNK_OVERLAP="150"

# -----------------------------------------------------------------------------
# Azure API Management (AI Gateway) — the public entry point WordPress calls
# -----------------------------------------------------------------------------
APIM_GATEWAY_URL="https://<your-apim>.azure-api.net/assistant"
# The APIM subscription key the WordPress proxy sends as Ocp-Apim-Subscription-Key.
APIM_SUBSCRIPTION_KEY=""

# APIM AI-gateway in FRONT of the Azure OpenAI model (token limits, token
# metrics, semantic caching, managed-identity backend auth). When BOTH are set,
# the chat-completions + embeddings clients route through APIM instead of
# calling Foundry directly. Leave blank to call Foundry directly (the default),
# so local / offline runs keep working.
#   * endpoint -> APIM host that serves the /openai route (client appends /openai/...).
#   * key      -> APIM subscription key for the AOAI API (sent as api-key header).
AZURE_OPENAI_GATEWAY_ENDPOINT="https://<your-apim>.azure-api.net"
AZURE_OPENAI_GATEWAY_KEY=""

# -----------------------------------------------------------------------------
# Observability (OpenTelemetry / Application Insights)
# -----------------------------------------------------------------------------
OTEL_ENABLED="false"
OTEL_SERVICE_NAME="county-assistant"
OTEL_EXPORTER_OTLP_ENDPOINT=""
APPLICATIONINSIGHTS_CONNECTION_STRING=""

# -----------------------------------------------------------------------------
# Chat guardrails
# -----------------------------------------------------------------------------
CHAT_MAX_INPUT_CHARS="4000"
CHAT_HISTORY_MAX_TURNS="12"