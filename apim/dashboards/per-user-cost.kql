// | order by TotalCost desc


// ─────────────────────────────────────────────────────────────────────────────
// Query B — AI spend over time, split by user      [chart: time chart / column]
// ─────────────────────────────────────────────────────────────────────────────
let pricing = PRICING_CL
    | summarize arg_max(TimeGenerated, *) by Model
    | project Model, InputTokensPrice, OutputTokensPrice;
AppMetrics
| where Name in ("Prompt Tokens", "Completion Tokens")
| extend UserId    = tostring(Properties["UserId"]),
         ModelName = tostring(Properties["ModelName"])
| where isnotempty(UserId) and UserId != "anonymous"
| summarize PromptTokens     = sumif(Sum, Name == "Prompt Tokens"),
            CompletionTokens = sumif(Sum, Name == "Completion Tokens")
        by UserId, ModelName, bin(TimeGenerated, 1h)
| join kind=inner pricing on $left.ModelName == $right.Model
| extend TotalCost = (PromptTokens * InputTokensPrice + CompletionTokens * OutputTokensPrice) / 1000
| summarize TotalCost = round(sum(TotalCost), 4) by TimeGenerated, UserId
| order by TimeGenerated asc


// ─────────────────────────────────────────────────────────────────────────────
// Query C — Budget vs actual by user (current month)   [chart: bar]
// Requires a per-user quota table USER_QUOTA_CL (UserId, CostQuota) — the
// per-user analogue of the upstream SUBSCRIPTION_QUOTA_CL. Seed it the same way.
// ─────────────────────────────────────────────────────────────────────────────
let pricing = PRICING_CL
    | summarize arg_max(TimeGenerated, *) by Model
    | project Model, InputTokensPrice, OutputTokensPrice;
let spend = AppMetrics
    | where TimeGenerated >= startofmonth(now()) and TimeGenerated <= endofmonth(now())
    | where Name in ("Prompt Tokens", "Completion Tokens")
    | extend UserId    = tostring(Properties["UserId"]),
             ModelName = tostring(Properties["ModelName"])
    | where isnotempty(UserId) and UserId != "anonymous"
    | summarize PromptTokens     = sumif(Sum, Name == "Prompt Tokens"),
                CompletionTokens = sumif(Sum, Name == "Completion Tokens")
            by UserId, ModelName
    | join kind=inner pricing on $left.ModelName == $right.Model
    | extend InputCost  = PromptTokens * InputTokensPrice,
             OutputCost = CompletionTokens * OutputTokensPrice
    | summarize InputCost = sum(InputCost), OutputCost = sum(OutputCost) by UserId
    | extend TotalCost = (InputCost + OutputCost) / 1000;
spend
| join kind=inner (
    USER_QUOTA_CL
    | summarize arg_max(TimeGenerated, *) by UserId
    | project UserId, CostQuota
  ) on UserId
| project UserId, CostQuota, TotalCost = round(TotalCost, 4)
| order by TotalCost desc


// ─────────────────────────────────────────────────────────────────────────────
// Query D — Team / department roll-up (showback)      [chart: bar / pie]
// Uses the TeamId dimension emitted alongside UserId.
// ─────────────────────────────────────────────────────────────────────────────
let pricing = PRICING_CL
    | summarize arg_max(TimeGenerated, *) by Model
    | project Model, InputTokensPrice, OutputTokensPrice;
AppMetrics
| where TimeGenerated >= startofmonth(now()) and TimeGenerated <= endofmonth(now())
| where Name in ("Prompt Tokens", "Completion Tokens")
| extend TeamId    = tostring(Properties["TeamId"]),
         ModelName = tostring(Properties["ModelName"])
| where isnotempty(TeamId)
| summarize PromptTokens     = sumif(Sum, Name == "Prompt Tokens"),
            CompletionTokens = sumif(Sum, Name == "Completion Tokens")
        by TeamId, ModelName
| join kind=inner pricing on $left.ModelName == $right.Model
| extend InputCost  = PromptTokens * InputTokensPrice,
         OutputCost = CompletionTokens * OutputTokensPrice
| summarize TotalCost = round(sum((InputCost + OutputCost)) / 1000, 4) by TeamId
| order by TotalCost desc


// ─────────────────────────────────────────────────────────────────────────────
// Query E (optional) — friendly names for Entra 'oid' GUIDs
// Production UserId values are Entra object-ids (GUIDs). Left-join a directory
// map USER_DIRECTORY_CL (UserId, DisplayName, Upn) to show people instead of
// GUIDs. Falls back to the raw oid when no mapping exists.
// ─────────────────────────────────────────────────────────────────────────────
let pricing = PRICING_CL
    | summarize arg_max(TimeGenerated, *) by Model
    | project Model, InputTokensPrice, OutputTokensPrice;
let directory = USER_DIRECTORY_CL
    | summarize arg_max(TimeGenerated, *) by UserId
    | project UserId, DisplayName, Upn;
AppMetrics
| where TimeGenerated >= startofmonth(now()) and TimeGenerated <= endofmonth(now())
| where Name in ("Prompt Tokens", "Completion Tokens")
| extend UserId    = tostring(Properties["UserId"]),
         ModelName = tostring(Properties["ModelName"])
| where isnotempty(UserId) and UserId != "anonymous"
| summarize PromptTokens     = sumif(Sum, Name == "Prompt Tokens"),
            CompletionTokens = sumif(Sum, Name == "Completion Tokens")
        by UserId, ModelName
| join kind=inner pricing on $left.ModelName == $right.Model
| extend InputCost  = PromptTokens * InputTokensPrice,
         OutputCost = CompletionTokens * OutputTokensPrice
| summarize InputCost = sum(InputCost), OutputCost = sum(OutputCost) by UserId
| extend TotalCost = round((InputCost + OutputCost) / 1000, 4)
| join kind=leftouter directory on UserId
| extend User = coalesce(Upn, DisplayName, UserId)
| project User, UserId, TotalCost
| order by TotalCost desc
