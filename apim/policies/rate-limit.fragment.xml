<!--
  Fragment: rate limiting + per-IP and per-subscription quotas.
  Inline within <inbound> or register as a policy fragment and <include-fragment />.
-->
<fragment>
  <!-- Short-window burst protection per client IP. -->
  <rate-limit-by-key calls="60" renewal-period="60"
    counter-key="@(context.Request.IpAddress)"
    remaining-calls-header-name="x-ratelimit-remaining"
    remaining-calls-variable-name="rateRemaining" />

  <!-- Daily quota per subscription to bound abuse/cost. -->
  <quota-by-key calls="5000" renewal-period="86400"
    counter-key="@(context.Subscription?.Id ?? context.Request.IpAddress)" />
</fragment>
