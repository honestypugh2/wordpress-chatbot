<!--
  PHASE 1 (applied) AI-gateway governance policy for the Azure OpenAI inference
  API (path: /aoai).

  This is the runnable subset that is live right now, BEFORE Azure Managed Redis
  is attached as an APIM external cache. It already delivers real governance:

    * authentication-managed-identity  -> APIM calls Foundry with its managed
                                          identity (resource cognitiveservices),
                                          so no model keys travel on the wire.
    * set-backend-service              -> routes to aoai-backend
                                          (Foundry Azure OpenAI /openai endpoint).
    * azure-openai-token-limit         -> 20000 tokens-per-minute per caller, with
                                          remaining/consumed-token response headers
                                          and automatic 429 enforcement.
    * azure-openai-emit-token-metric   -> token usage metrics to Application
                                          Insights (logger: appinsights).

  The semantic-cache-lookup / semantic-cache-store elements from
  aoai-api.policy.xml are intentionally omitted here because they require an
  external Redis cache with the RediSearch module. They are added in phase 2
  once Azure Managed Redis (wpcounty-amr-mro5df) is provisioned and registered
  as an APIM external cache.

  PER-USER COST ATTRIBUTION (added): resolves a per-user identity and emits it
  as a UserId dimension so chargeback/showback can be done per individual user,
  not just per subscription/team. Identity precedence:
    1. Entra ID 'oid' claim  (validated when an Authorization bearer is present)
    2. x-user-id header      (set by a TRUSTED server-side proxy only)
    3. subscription id       (per-consumer fallback)

  !! NOT-YET-APPLIED PREREQUISITE (Entra JWT path) !!
  The <validate-jwt> block below references two Named Values,
  {{entra-openid-config}} and {{entra-audience}}. APIM resolves Named-Value
  references at apply time, so this policy can only be pushed to the live API
  AFTER those Named Values exist. {{entra-audience}} requires an Entra ID **app
  registration** for this API (Application ID URI / client id). The environment
  that owns this subscription may lack app-
  registration privileges, so this step must be completed in an Azure
  subscription/tenant where the operator has admin rights for app registrations.
  Until then, the LIVE policy runs header + subscription attribution only (the
  <choose> makes the JWT path no-op when no Authorization header is present, so
  enabling it is non-breaking for existing api-key callers).
-->
<policies>
    <inbound>
        <base />
        <set-backend-service backend-id="aoai-backend" />
        <authentication-managed-identity resource="https://cognitiveservices.azure.com" />

        <!-- Resolve per-user identity (header > subscription). The optional
             validate-jwt block below overrides this with the Entra 'oid'. -->
        <set-variable name="userId" value="@{
            var header = context.Request.Headers.GetValueOrDefault("x-user-id", "");
            if (!string.IsNullOrEmpty(header)) { return header; }
            return context.Subscription?.Id ?? context.Request.IpAddress ?? "anonymous";
        }" />
        <set-variable name="teamId"
            value="@(context.Request.Headers.GetValueOrDefault("x-team-id", "unassigned"))" />
        <set-variable name="requestId"
            value="@(context.Request.Headers.GetValueOrDefault("x-request-id", Guid.NewGuid().ToString()))" />

        <!-- Entra ID SSO attribution (non-breaking): only runs when the caller
             presents an Authorization bearer token. When it does, the token is
             validated and userId is overridden with the tamper-proof 'oid'.
             api-key-only callers (no Authorization header) skip this entirely.
             Requires Named Values {{entra-openid-config}} and {{entra-audience}};
             see the NOT-YET-APPLIED PREREQUISITE note in the header. -->
        <choose>
            <when condition="@(context.Request.Headers.ContainsKey("Authorization"))">
                <validate-jwt header-name="Authorization" failed-validation-httpcode="401"
                              failed-validation-error-message="Invalid or missing Entra ID token."
                              output-token-variable-name="jwt">
                    <openid-config url="{{entra-openid-config}}" />
                    <audiences>
                        <audience>{{entra-audience}}</audience>
                    </audiences>
                </validate-jwt>
                <set-variable name="userId"
                    value="@(((Jwt)context.Variables["jwt"]).Claims.GetValueOrDefault("oid", (string)context.Variables["userId"]))" />
            </when>
        </choose>

        <azure-openai-token-limit
            counter-key="@((string)context.Variables["userId"])"
            tokens-per-minute="20000"
            estimate-prompt-tokens="false"
            remaining-tokens-header-name="x-ratelimit-remaining-tokens"
            tokens-consumed-header-name="x-ratelimit-consumed-tokens" />
        <azure-openai-emit-token-metric namespace="genai">
            <dimension name="UserId" value="@((string)context.Variables["userId"])" />
            <dimension name="TeamId" value="@((string)context.Variables["teamId"])" />
            <dimension name="API ID" />
            <dimension name="Operation ID" />
            <dimension name="Subscription ID" />
        </azure-openai-emit-token-metric>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
        <!-- Echo the resolved identity so the client can reconcile its record. -->
        <set-header name="x-user-id" exists-action="override">
            <value>@((string)context.Variables["userId"])</value>
        </set-header>
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
