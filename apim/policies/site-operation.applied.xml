<!--
  County Assistant — APIM site operation policy (APPLIED / runnable)

  Applied to GET /assistant/site. Returns the active demo-site profile
  (DEMO_SITE_PROFILE) so the WordPress widget can self-configure its title and
  greeting on load without rebuilding the page.

  Flow: WordPress server-side proxy -> APIM (subscription key) -> Azure Function
  /api/site. The backend Function uses anonymous auth, so no backend-token swap
  is needed.
-->
<policies>
    <inbound>
        <base />
        <!-- CORS: belt-and-suspenders for any direct browser GET during testing. -->
        <cors allow-credentials="false">
            <allowed-origins>
                <origin>http://localhost:8083</origin>
                <origin>https://county-portal.example.gov</origin>
            </allowed-origins>
            <allowed-methods>
                <method>OPTIONS</method>
                <method>GET</method>
            </allowed-methods>
            <allowed-headers>
                <header>Content-Type</header>
                <header>X-Correlation-Id</header>
                <header>Ocp-Apim-Subscription-Key</header>
            </allowed-headers>
            <expose-headers>
                <header>X-Correlation-Id</header>
            </expose-headers>
        </cors>
        <!-- Correlation: reuse inbound id or mint one; flow it downstream. -->
        <set-variable name="correlationId" value="@(context.Request.Headers.GetValueOrDefault("X-Correlation-Id", Guid.NewGuid().ToString("N")))" />
        <set-header name="X-Correlation-Id" exists-action="override">
            <value>@((string)context.Variables["correlationId"])</value>
        </set-header>
        <!-- Per-IP rate limiting for basic abuse protection. -->
        <rate-limit-by-key calls="120" renewal-period="60" counter-key="@(context.Request.IpAddress)" />
        <!-- Route to the Function backend and rewrite to its /api/site route. -->
        <set-backend-service backend-id="assistant-backend" />
        <rewrite-uri template="/api/site" />
    </inbound>
    <backend>
        <forward-request timeout="30" />
    </backend>
    <outbound>
        <base />
        <set-header name="X-Correlation-Id" exists-action="override">
            <value>@((string)context.Variables["correlationId"])</value>
        </set-header>
        <set-header name="Server" exists-action="delete" />
    </outbound>
    <on-error>
        <base />
        <set-header name="X-Correlation-Id" exists-action="override">
            <value>@((string)context.Variables.GetValueOrDefault("correlationId", ""))</value>
        </set-header>
    </on-error>
</policies>
